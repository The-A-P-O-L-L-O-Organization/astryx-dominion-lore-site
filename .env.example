CONTENT_REPO_URL=https://github.com/your-org/astryx-dominion-lore.git
SESSION_SECRET=replace-with-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password
DATABASE_PATH=./data/app.db
# Require the x-poll-secret header on GET /api/poll-content
POLL_SECRET=
# Set to true when serving over HTTPS so the session cookie gets the Secure flag
SECURE_COOKIES=false
